      "type": "text",
      "fontSize": 13,
      "fontFamily": 2,
      "text": "Excalidraw offers three stroke weights only (thin, bold, extra bold): our 1.3 · 1.6 · 2.4 · 3.2 px collapse to 1 · 1 · 2 · 4.",
      "originalText": "Excalidraw offers three stroke weights only (thin, bold, extra bold): our 1.3 · 1.6 · 2.4 · 3.2 px collapse to 1 · 1 · 2 · 4.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "logolibres-0031",
      "x": 40,
      "y": 710,
      "width": 1000,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#5B6873",
      "backgroundColor": "transparent",
