      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "fontSize": 13,
      "fontFamily": 2,
      "text": "Its interface offers two roundnesses, sharp or round, with no radius exposed: rx 3, 8, 10 and 12 become the same corner.",
      "originalText": "Its interface offers two roundnesses, sharp or round, with no radius exposed: rx 3, 8, 10 and 12 become the same corner.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
